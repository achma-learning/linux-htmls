#include <winver.h>
#include "resource.h"

IDI_APP   ICON    "icons/prayer-tray.ico"
IDR_PAGE  RCDATA  "../../html file/start-dock.html"
1         24      "app.manifest"   /* RT_MANIFEST, CREATEPROCESS_MANIFEST_RESOURCE_ID */

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName",      "achma-learning"
      VALUE "FileDescription",  "Prayer Spine - day spine, prayer times and weather in the tray"
      VALUE "FileVersion",      "1.0.0"
      VALUE "InternalName",     "prayer-tray"
      VALUE "OriginalFilename", "prayer-tray.exe"
      VALUE "ProductName",      "Achma tray icons"
      VALUE "ProductVersion",   "1.0.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
